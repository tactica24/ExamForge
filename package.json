{
  "name": "ace-naija",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node -r ./scripts/fs-readlink-eisdir-fix.cjs ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cypress run",
    "format": "prettier . --check",
    "firebase:env:print": "node scripts/firebase-env-from-service-account.mjs",
    "firebase:role:set": "node scripts/firebase-set-role.mjs",
    "mobile:url:set": "node scripts/mobile-set-app-url.mjs",
    "mobile:android:sync": "npx cap sync android",
    "mobile:android:prepare": "npm install --no-save @capacitor/cli@8 @capacitor/core@8 @capacitor/android@8 @capacitor/assets",
    "mobile:android:add": "npx cap add android",
    "mobile:android:assets": "npx @capacitor/assets generate --android --assetPath assets --iconBackgroundColor '#0a0f2c' --splashBackgroundColor '#0a0f2c'",
    "mobile:android:open": "npx cap open android",
    "mobile:ios:sync": "npx cap sync ios",
    "mobile:ios:prepare": "npm install --no-save @capacitor/cli@8 @capacitor/core@8 @capacitor/ios@8 @capacitor/assets",
    "mobile:ios:add": "npx cap add ios",
    "mobile:ios:assets": "npx @capacitor/assets generate --ios --assetPath assets --iconBackgroundColor '#0a0f2c' --splashBackgroundColor '#0a0f2c'",
    "mobile:ios:open": "npx cap open ios",
    "load:smoke": "node scripts/load-smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.0.2",
    "firebase-admin": "^13.0.1",
    "google-tts-api": "^2.0.2",
    "lucide-react": "^0.476.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.4",
    "openai": "^4.85.4",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "cypress": "^13.16.1",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
